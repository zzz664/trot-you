{
  "name": "trot-you",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:all": "npm run lint && npm run typecheck && npm run test && npm run check:contrast && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:lint": "supabase db lint --local --schema public,private --level warning --fail-on warning",
    "db:migrate:new": "supabase migration new",
    "test:integration": "supabase test db --local",
    "test:db:concurrency": "node scripts/test-billing-concurrency.mjs",
    "test:db:messaging-concurrency": "node scripts/test-messaging-concurrency.mjs",
    "test:db:community-concurrency": "node scripts/test-community-concurrency.mjs",
    "test:db:schedule-concurrency": "node scripts/test-schedule-concurrency.mjs",
    "test:db:points-concurrency": "node scripts/test-points-concurrency.mjs",
    "test:db:notification-concurrency": "node scripts/test-notification-concurrency.mjs",
    "test:db:analytics-concurrency": "node scripts/test-analytics-concurrency.mjs",
    "test:db:settlement-concurrency": "node scripts/test-settlement-concurrency.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
