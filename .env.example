# Public allowlist: these values may be embedded in the browser at build time.
# Never place server keys, billing keys, SID, tokens or personal data here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# A publishable sb_publishable_* key OR a legacy JWT whose role is anon.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Authentication needs only the public Supabase URL/key and the exact app origin
# above. Configure Kakao REST API key/client secret IN SUPABASE, not in this app.
# Supabase redirect allowlist: <NEXT_PUBLIC_APP_URL>/api/auth/callback
# Kakao redirect URI: the Supabase dashboard's /auth/v1/callback URL.
# No hosted provider or production operation is enabled by this example.
# Billing MID's API individual client key: test_ck_* or live_ck_* (not gck).
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# Server-only credentials. Empty means missing, not a successful connection.
# Keep real values in .env.local or the deployment provider's secret store.
# A secret sb_secret_* key OR a legacy JWT whose role is service_role.
# Required for trusted artist-preview, checkout and enrollment RPCs;
# authentication, offer reads and interest selection use the actor-scoped key.
SUPABASE_SERVICE_ROLE_KEY=

# No mock mode exists. Authentication does not enable payments or charge anyone.
# Set test/live deliberately and enable each provider separately when integrating.
# Initial enrollment uses real adapters when merchant credentials AND the
# dedicated vault key/version are present. Explicit customer confirmation can
# perform the first charge. Never activate live mode without merchant approval.
# A current approved/published checkout policy with exact prices, explicit UTC or
# Seoul monthly-clamped calendar and taxable-KRW basis is required; unset fails closed.
# Provider callback origin is NEXT_PUBLIC_APP_URL; never use request Host/returnUrl.
# Production rejects fixture/mock transport. The isolated GitHub CI development
# harness has an additional loopback-only injection gate, not a deployment option.
PAYMENTS_MODE=disabled
TOSS_BILLING_ENABLED=false
KAKAOPAY_SUBSCRIPTION_ENABLED=false
# Matching test_sk_* or live_sk_* key for the same billing MID as the client key.
TOSS_SECRET_KEY=
TOSS_BILLING_MID=
# KakaoPay's Secret key (not Kakao Login's key). Opaque key mode is not verifiable
# offline; test mode uses recurring CID TCSUBSCRIP, live uses an approved CID.
KAKAOPAY_SECRET_KEY=
KAKAOPAY_RECURRING_CID=
# Optional only if actually issued for the merchant.
KAKAOPAY_CID_SECRET=
# Dedicated AES-256-GCM encryption key: canonical base64 encoding of 32 bytes.
# Provision independently through the secret store; never reuse provider keys.
# Version must identify the configured key; unknown stored versions fail closed.
# Rotation requires reviewed retention/migration of existing encrypted credentials.
PAYMENTS_VAULT_KEY=
PAYMENTS_VAULT_KEY_VERSION=

# Future integrations: presence is not delivery/authentication verification.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ALIMTALK_API_KEY=
# At least 16 non-whitespace characters, as required by the source design.
CRON_SECRET=

# Explicit component harness opt-in; disabled by default, no persistence.
UI_PREVIEW_ENABLED=false

# No invented TOSS_WEBHOOK_SECRET or obsolete PAYMENT_PROVIDER=mock setting.
# Alimtalk vendor/templates and VAPID contact remain future integration settings.

# Renewal code is disabled by default. Enabling requires an explicitly approved
# immutable renewal policy, accepted current checkout terms, merchant review,
# notice evidence where required, and separately authorized scheduler setup.
# Dedicated bearer token, 32-256 URL-safe characters; do not reuse CRON_SECRET.
PAYMENTS_RENEWALS_ENABLED=false
RENEWAL_CRON_SECRET=
