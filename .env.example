# Public browser-visible origin only. Never put private keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# This foundation does not connect to any external service.
# Supabase, payment, notification and cron credentials will be introduced with
# their own server-only validation when those features are implemented.
# Keep real values in .env.local or the deployment provider's secret store.

# Optional development-only component harness; disabled by default.
UI_PREVIEW_ENABLED=false
